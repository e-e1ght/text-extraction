{
  "manifest_version": 3,
  "name": "AI 채팅 txt 추출기",
  "version": "0.8.1",
  "description": "AI 채팅 사이트의 대화 내역을 txt 파일로 저장합니다.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": [
    "https://caveduck.io/*",
    "https://*.caveduck.io/*",
    "https://rofan.ai/*",
    "https://*.rofan.ai/*",
    "https://teapotchat.com/*",
    "https://*.teapotchat.com/*",
    "https://firestore.googleapis.com/*",
    "https://elyn.ai/*",
    "https://*.elyn.ai/*",
    "https://crack.wrtn.ai/*",
    "https://crack-api.wrtn.ai/*",
    "https://univers.chat/*",
    "https://*.univers.chat/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "대화 추출 패널 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://caveduck.io/*", "https://*.caveduck.io/*", "https://rofan.ai/*", "https://*.rofan.ai/*", "https://teapotchat.com/*", "https://*.teapotchat.com/*", "https://elyn.ai/*", "https://*.elyn.ai/*", "https://crack.wrtn.ai/*", "https://univers.chat/*", "https://*.univers.chat/*"],
      "js": ["adapters/registry.js", "adapters/caveduck.js", "adapters/rofan.js", "adapters/teapot.js", "adapters/elyn.js", "adapters/crack.js", "adapters/unichat.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
